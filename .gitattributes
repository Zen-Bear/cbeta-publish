# 文本文件统一按 LF 存储（避免 Windows 上 CRLF 反复转换）
* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ttf binary
*.ttc binary
*.otf binary
*.pdf binary
*.zip binary
*.epub binary
assets/**/*.pdf filter=lfs diff=lfs merge=lfs -text
assets/**/*.tif filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.otf filter=lfs diff=lfs merge=lfs -text
assets/**/*.ttf filter=lfs diff=lfs merge=lfs -text
