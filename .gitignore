# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---- 下载/缓存数据（可重新获取） ----
cbeta_ebooks/
cbeta_xml/
cbeta_ebooks_xml/
cbeta_xml_ebooks/
cbeta_verify/
collections_books/
mulu/cache/

# ---- 合成产物 / 临时文件 ----
my_books/
*.zip
_tmp_cover/
_export/

# 说明：assets/（含高分辨率扫描件与字体）已按需纳入版本控制。

# ---- 用户运行期配置（不进版本库；出厂模板见 config/app.default.json）----
# 程序运行期会改写 app.json，跟踪它会被 `git checkout` 覆盖用户设置，故永不跟踪。
config/app.json

# ---- 备份目录：全部为运行期数据快照，不进版本库 ----
mulu/backup/

# ---- 本地 UI 状态（不进版本库）----
config/ui_state.json
config/verify_records.json
config/official_state.json

# ---- 说明文件：用户私有，仅随包示例 sample.txt 进库 ----
assets/notes/*
!assets/notes/sample.txt

# ---- 派生缓存 ----
collections/index.json

# ---- 编辑器/系统 ----
.idea/
.vscode/
Thumbs.db
desktop.ini

# ---- 打包产物 ----
dist/
build/
*.spec.bak

# ---- 示例输出 demo/（反向放行，覆盖上面的产物忽略规则） ----
!demo/
!demo/cbeta_xml_ebooks/
!demo/cbeta_xml_ebooks/**
!demo/collections_books/
!demo/collections_books/**

